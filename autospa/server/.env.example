# ============================================================
#  AutoSpa server environment
#  Copy to server/.env and fill in. REQUIRED vars fail-fast if missing.
# ============================================================

# --- Database (REQUIRED) ---
MONGO_URI=mongodb://localhost:27017/autospa?directConnection=true
REDIS_URL=redis://localhost:6379

# --- Auth (REQUIRED) ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
OTP_TTL=600

# --- Server ---
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# --- Stripe (payments; optional until you go live) ---
# Without STRIPE_SECRET_KEY, POST /payments/create-order returns 503.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=usd

# --- Cloudinary (image uploads; optional — mock URLs used if absent) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Brevo Email (optional — OTP/console fallback used if absent) ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@autospa.local
BREVO_FROM_NAME=AutoSpa

# --- Background jobs ---
REMINDER_LEAD_HOURS=24
